# DRY_RUN is the safe default. Both values are required for any external write.
CAMPAIGN_MODE=DRY_RUN
CAMPAIGN_LIVE_SEND=false
CAMPAIGN_CONFIG_DIR=./config
CAMPAIGN_DATABASE_URL=sqlite:///./campaign.db
CAMPAIGN_REPOSITORY_ROOT=..
CAMPAIGN_REPORT_DIR=./reports
CAMPAIGN_LOG_LEVEL=INFO

# Google OAuth desktop-client JSON downloaded from Google Cloud Console.
GOOGLE_OAUTH_CLIENT_FILE=./secrets/google-oauth-client.json
# Encrypted token envelope. The encryption key is held by the OS credential store.
GOOGLE_OAUTH_TOKEN_FILE=./secrets/google-token.enc
GOOGLE_OAUTH_ACCOUNT=

# Optional provider configuration. Deterministic fixture/template providers are defaults.
SEARCH_PROVIDER=fixture
SEARCH_API_ENDPOINT=
SEARCH_API_KEY=
LLM_PROVIDER=deterministic
LLM_API_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=

# Required before LIVE outreach can pass compliance.
CAMPAIGN_SENDER_NAME=
CAMPAIGN_SENDER_EMAIL=
CAMPAIGN_ORGANIZATION=Jneopallium
CAMPAIGN_POSTAL_ADDRESS=
CAMPAIGN_REPLY_TO=
CAMPAIGN_ESCALATION_EMAIL=
CAMPAIGN_DEFAULT_TIMEZONE=Europe/Kyiv

# Never enable this outside a dedicated test account.
JNEO_ENABLE_LIVE_TESTS=false
